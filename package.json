{
  "name": "bucketdump-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Tipping-bucket water park simulator (2D canvas + 3D three.js view)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "./scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
